---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Cta from '../../components/Cta.astro';
import { GLOSSARY } from '../../data/glossary';
import { REGULATIONS } from '../../data/regulations';
import { breadcrumbLd, definedTermSetLd, graph } from '../../lib/seo';
import { ACCESS_MAILTO, LABS_URL } from '../../consts';

const title = 'EU digital identity glossary: EUDI and eIDAS terms in plain language';
const description =
  'Plain-language explanations of the EU digital identity terms that actually matter: access certificates, trusted lists, the age verification attestation. Written from building a verifier, not from a spec summary.';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Glossary', path: '/glossary' },
];
const jsonLd = graph(
  breadcrumbLd(crumbs),
  definedTermSetLd(GLOSSARY.map((t) => ({ name: t.term, description: t.short, slug: t.slug }))),
);

// The regulation pages are the deliberate handoff for the terms this glossary does not define.
const related = REGULATIONS.map((r) => ({ label: r.name, href: `/${r.slug}`, note: r.category }));
---

<Base title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} is:inline />

  <Header />

  <main class="flex-1">
    <section class="max-w-6xl mx-auto px-6 pt-16 pb-10 md:pt-24">
      <Breadcrumbs items={crumbs} />
      <p class="text-sm font-medium uppercase tracking-widest mb-4" style="color: var(--color-accent);">
        Glossary
      </p>
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight leading-[1.1] mb-5">
        EU digital identity, in plain language
      </h1>
      <p class="text-lg md:text-xl leading-relaxed max-w-3xl" style="color: var(--color-text);">
        This field runs on acronyms, and most explanations of them are just the specification with shorter
        sentences. These are written from building and running an EUDI verifier, so each one says what the
        thing is, what it does to you in practice, and where we got it wrong ourselves.
      </p>
      <p class="text-base leading-relaxed max-w-3xl mt-4" style="color: var(--color-text-muted);">
        Where we have a free validator for the thing being explained, the entry links to it. You can read the
        definition and then go and inspect a real one.
      </p>
    </section>

    <section class="max-w-6xl mx-auto px-6 pb-16">
      <div class="grid gap-4 sm:grid-cols-2">
        {
          GLOSSARY.map((t) => (
            <a
              href={`/glossary/${t.slug}`}
              class="block rounded-xl border p-6 transition-opacity hover:opacity-80"
              style="background-color: var(--color-bg-elevated); border-color: var(--color-border);"
            >
              <p class="text-xs font-medium uppercase tracking-widest mb-2" style="color: var(--color-accent);">
                {t.category}
              </p>
              <p class="text-lg font-semibold tracking-tight mb-2">{t.term}</p>
              <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">
                {t.short}
              </p>
            </a>
          ))
        }
      </div>
      <p class="text-sm mt-8" style="color: var(--color-text-muted);">
        More terms are being added. If there is one you keep having to look up, tell us and we will write it.
        The validators behind these entries are free at
        <a href={LABS_URL} target="_blank" rel="noopener" class="underline" style="color: var(--color-accent);">
          labs.tessio.eu</a
        >.
      </p>
    </section>

    <RelatedLinks heading="The rules behind the jargon" links={related} />

    <Cta
      eyebrow="Age verification API"
      title="Prove someone is over 18, and learn nothing else"
      body="Tessio checks one claim from the EU Digital Identity Wallet and stores no personal data. Access is invite-only while we onboard design partners. Tell us what you're building."
      buttonLabel="Request access"
      buttonHref={ACCESS_MAILTO}
      secondaryLabel="Read the docs"
      secondaryHref="/docs"
    />
  </main>

  <Footer />
</Base>
