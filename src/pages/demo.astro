---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Cta from '../components/Cta.astro';
import DemoFlow from '../components/DemoFlow.astro';
import { breadcrumbLd, graph, serviceLd } from '../lib/seo';
import { ACCESS_MAILTO, VERIFIER_REPO } from '../consts';

const title = 'Live demo';
const description =
  'Run an EU Digital Identity Wallet age check in your browser. No account, no personal data stored, and the request is the same one a customer integration receives.';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Demo', path: '/demo' },
];
const jsonLd = graph(
  breadcrumbLd(crumbs),
  serviceLd({
    name: 'Tessio Cloud age verification demo',
    description,
    url: '/demo',
    category: 'Age verification',
  }),
);

const points: { heading: string; body: string }[] = [
  {
    heading: 'Only a yes or no',
    body: 'The wallet discloses one boolean, age_over_18. No name, no date of birth, no document scan, so there is no identity document to leak later.',
  },
  {
    heading: 'A no is a real answer',
    body: 'A valid credential can disclose that the holder is under age. Proving a credential is authentic is a different question from what it says.',
  },
  {
    heading: 'Unanswerable is its own state',
    body: 'When a presentation carries no usable claim, the check reports that rather than guessing. A verification product inventing a pass is the worst thing it can do.',
  },
];
---

<Base title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} is:inline />

  <Header />

  <main class="flex-1">
    <section class="max-w-6xl mx-auto px-6 pt-16 pb-10 md:pt-24">
      <Breadcrumbs items={crumbs} />
      <p class="text-sm font-medium uppercase tracking-widest mb-4" style="color: var(--color-accent);">
        Live demo
      </p>
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight leading-[1.1] mb-5">
        See an age check run
      </h1>
      <p class="text-lg leading-relaxed max-w-2xl mb-10" style="color: var(--color-text-muted);">
        Starting a check runs the product's own code and returns a real OpenID4VP request, asking a wallet
        for one claim and nothing else. Answering it from a wallet needs a reader certificate we have not
        been issued yet, so buttons stand in for that step. They skip verification rather than fake it, and
        the result says which one answered. No account, and nothing recorded about you either way.
      </p>

      <DemoFlow />
    </section>

    <section class="max-w-6xl mx-auto px-6 pb-16">
      <div class="grid gap-8 sm:grid-cols-3">
        {
          points.map((p) => (
            <div>
              <h2 class="text-sm font-semibold mb-1">{p.heading}</h2>
              <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">
                {p.body}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <Cta
      eyebrow="Ready when you are"
      title="Put this in your checkout or sign-up"
      body="The same check, behind your own API key. Tell us what you are building and we will get you access."
      buttonLabel="Request access"
      buttonHref={ACCESS_MAILTO}
      secondaryLabel="Read the verifier source"
      secondaryHref={VERIFIER_REPO}
    />
  </main>

  <Footer />
</Base>
