---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DemoFlow from '../components/DemoFlow.astro';
import { CLOUD_URL } from '../consts';

const title = 'Live demo';
const description =
  'Run an EU Digital Identity Wallet age check in your browser. No account, no personal data stored, and the request is the same one a customer integration receives.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Tessio live age verification demo',
  description,
  url: 'https://tessio.eu/demo',
};

const points: { heading: string; body: string }[] = [
  {
    heading: 'Only a yes or no',
    body: 'The wallet discloses one boolean, age_over_18. No name, no date of birth, no document scan, so there is no identity document to leak later.',
  },
  {
    heading: 'A no is a real answer',
    body: 'A valid credential can disclose that the holder is under age. Proving a credential is authentic is a different question from what it says.',
  },
  {
    heading: 'Unanswerable is its own state',
    body: 'When a presentation carries no usable claim, the check reports that rather than guessing. A verification product inventing a pass is the worst thing it can do.',
  },
];
---

<Base title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <Header />

  <main class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-4">See an age check run</h1>
    <p class="text-lg leading-relaxed mb-10" style="color: var(--color-text-muted);">
      Starting a check builds the same signed OpenID4VP request a customer integration receives. Scan it
      with an EU Digital Identity Wallet and it is verified for real, against the live trust list. Almost
      nobody holds one yet, so there are buttons that stand in for the wallet. Those skip the verification
      step rather than fake it, and the result says which one answered. No account either way.
    </p>

    <DemoFlow />

    <section class="grid gap-6 sm:grid-cols-3 mt-12">
      {points.map((p) => (
        <div>
          <h2 class="text-sm font-semibold mb-1">{p.heading}</h2>
          <p class="text-xs leading-relaxed" style="color: var(--color-text-muted);">{p.body}</p>
        </div>
      ))}
    </section>

    <p class="text-sm mt-12 pt-6 border-t" style="border-color: var(--color-border); color: var(--color-text-muted);">
      Want this in your checkout or sign-up?{' '}
      <a href={CLOUD_URL} class="underline" style="color: var(--color-accent);">Get in touch</a>.
    </p>
  </main>

  <Footer />
</Base>
