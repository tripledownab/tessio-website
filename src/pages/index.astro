---
import Base from '../layouts/Base.astro';

const verifierUrl = 'https://verifier.tessio.eu';
const verifierRepo = 'https://github.com/tripledownab/tessio-verifier';
const nugetUrl = 'https://www.nuget.org/packages/Tessio.Verifier.AspNetCore';
const contactEmail = 'hello@tessio.eu';

const pillars = [
  {
    title: 'Open-source verifier',
    body: 'Tessio.Verifier, the .NET-native implementation. OpenID4VP 1.0, SD-JWT VC and mdoc (mDL), four run modes so you can build before wallets ship. On NuGet, Apache-2.0.',
    cta: { label: 'Go to verifier.tessio.eu', href: verifierUrl },
  },
  {
    title: 'Managed trust layer',
    body: 'WRPAC registration, 27-state trust-list aggregation, hosted dashboards. The hard parts of taking a verifier to production, run for you.',
    cta: { label: 'Available 2027, get on the list', href: `mailto:${contactEmail}?subject=Tessio%20managed%20trust%20layer` },
  },
  {
    title: 'EUDI for the .NET ecosystem',
    body: 'A bridge between the EU Digital Identity Wallet and the stacks .NET shops already run. No translating from Kotlin or Rust.',
    cta: { label: 'Get it on NuGet', href: nugetUrl },
  },
];

const timeline = [
  { date: 'Now', body: 'Tessio.Verifier 0.2 ships. SD-JWT VC and mdoc (mDL) verification, four run modes, checked against the specification\'s own test vectors. On NuGet for .NET 8 to 10, usable today.' },
  { date: 'Dec 2026', body: 'Member states must make the EUDI Wallet available under Regulation (EU) 2024/1183. Real credentials to verify.' },
  { date: '6 Dec 2027', body: 'Mandatory acceptance. Regulated .NET relying parties need a verifier in production.' },
];
---

<Base>
  <header
    class="sticky top-0 z-10 backdrop-blur-md border-b"
    style="background-color: color-mix(in srgb, var(--color-bg) 85%, transparent); border-color: var(--color-border);"
  >
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
        <svg width="24" height="24" viewBox="0 0 32 32" aria-hidden="true">
          <rect width="32" height="32" rx="6" fill="var(--color-accent)" />
          <path d="M9 11h14M9 16h14M9 21h9" stroke="white" stroke-width="2.5" stroke-linecap="round" />
          <circle cx="22" cy="21" r="3" fill="none" stroke="white" stroke-width="2.5" />
        </svg>
        <span>Tessio</span>
      </a>
      <nav class="flex items-center gap-6 text-sm">
        <a href="#what" class="hover:opacity-70 transition-opacity">What</a>
        <a href="#why" class="hover:opacity-70 transition-opacity">Why</a>
        <a href={verifierUrl} class="hover:opacity-70 transition-opacity">Verifier</a>
        <a
          href={`mailto:${contactEmail}`}
          class="px-3 py-1.5 rounded-md text-white text-xs font-medium"
          style="background-color: var(--color-accent);"
        >
          Get in touch
        </a>
      </nav>
    </div>
  </header>

  <main class="flex-1">
    <!-- Hero -->
    <section class="max-w-6xl mx-auto px-6 pt-20 pb-16 md:pt-32 md:pb-24">
      <div class="max-w-3xl">
        <p class="text-sm font-medium uppercase tracking-widest mb-6" style="color: var(--color-accent);">
          EU Digital Identity · .NET
        </p>
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight leading-[1.05] mb-6">
          The EUDI Wallet,<br />
          <span style="color: var(--color-text-muted);">on your .NET stack.</span>
        </h1>
        <p class="text-lg md:text-xl leading-relaxed max-w-2xl mb-10" style="color: var(--color-text-muted);">
          Tessio builds the verification stack for the EU Digital Identity Wallet. It starts with an
          <strong style="color: var(--color-text);">open-source ASP.NET Core verifier</strong>, already on NuGet, and grows into the
          managed trust layer that .NET teams will need by December 2027.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href={verifierUrl}
            class="px-5 py-3 rounded-md font-medium text-white transition-opacity hover:opacity-90"
            style="background-color: var(--color-accent);"
          >
            See the verifier →
          </a>
          <a
            href="#what"
            class="px-5 py-3 rounded-md font-medium border transition-colors"
            style="border-color: var(--color-border);"
          >
            What we're building
          </a>
        </div>
      </div>
    </section>

    <!-- What -->
    <section class="max-w-6xl mx-auto px-6 pb-24" id="what">
      <h2 class="text-3xl font-bold tracking-tight mb-3">What we ship</h2>
      <p class="mb-12 text-lg max-w-2xl" style="color: var(--color-text-muted);">
        Two layers, one ecosystem. Open-source where the protocol lives. Managed where the operational burden lives.
      </p>
      <div class="grid gap-6 md:grid-cols-3">
        {
          pillars.map((p) => (
            <div
              class="rounded-xl border p-6 flex flex-col"
              style="background-color: var(--color-bg-elevated); border-color: var(--color-border);"
            >
              <h3 class="text-lg font-semibold tracking-tight mb-3">{p.title}</h3>
              <p class="text-sm leading-relaxed mb-6 flex-1" style="color: var(--color-text-muted);">
                {p.body}
              </p>
              <a
                href={p.cta.href}
                class="text-sm font-medium hover:opacity-70 transition-opacity"
                style="color: var(--color-accent);"
              >
                {p.cta.label} →
              </a>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Why -->
    <section class="max-w-6xl mx-auto px-6 pb-24" id="why">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="text-3xl font-bold tracking-tight mb-6">Why now</h2>
          <p class="text-base leading-relaxed mb-4" style="color: var(--color-text-muted);">
            Regulation <a href="https://eur-lex.europa.eu/eli/reg/2024/1183/oj" target="_blank" rel="noopener" style="color: var(--color-accent);" class="underline">(EU) 2024/1183</a>
            mandates that all 27 member states issue a Digital Identity Wallet and obliges relying parties in regulated
            sectors to accept it by <strong style="color: var(--color-text);">6 December 2027</strong>.
          </p>
          <p class="text-base leading-relaxed" style="color: var(--color-text-muted);">
            The reference verifier work happens in Kotlin and Rust. .NET shops, and there are a lot of them in EU
            public-sector and finance, are left translating. Tessio closes that gap.
          </p>
        </div>
        <div>
          <h3 class="text-sm font-medium uppercase tracking-widest mb-6" style="color: var(--color-text-muted);">
            Timeline
          </h3>
          <ol class="space-y-5">
            {
              timeline.map((t) => (
                <li class="border-l-2 pl-4" style="border-left-color: var(--color-accent);">
                  <p class="text-xs font-mono uppercase tracking-wider mb-1" style="color: var(--color-accent);">
                    {t.date}
                  </p>
                  <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">
                    {t.body}
                  </p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="max-w-6xl mx-auto px-6 pb-24" id="contact">
      <div
        class="rounded-xl border-l-4 p-6 md:p-8"
        style="background-color: var(--color-bg-elevated); border-left-color: var(--color-accent); border-color: var(--color-border);"
      >
        <p class="text-xs font-medium uppercase tracking-widest mb-3" style="color: var(--color-accent);">
          Working on EUDI?
        </p>
        <h3 class="text-2xl font-bold tracking-tight mb-3">Let's talk.</h3>
        <p class="text-base leading-relaxed mb-6 max-w-2xl" style="color: var(--color-text-muted);">
          We're talking to .NET teams running verification pilots, integrators planning 2027 rollout and member-state
          authorities looking for an EU-aligned reference stack. If that's you, drop a line.
        </p>
        <a
          href={`mailto:${contactEmail}?subject=Tessio`}
          class="inline-block px-5 py-3 rounded-md font-medium text-white transition-opacity hover:opacity-90"
          style="background-color: var(--color-accent);"
        >
          {contactEmail}
        </a>
      </div>
    </section>
  </main>

  <footer class="border-t" style="border-color: var(--color-border);">
    <div
      class="max-w-6xl mx-auto px-6 py-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-6"
    >
      <div>
        <p class="font-semibold tracking-tight">Tessio</p>
        <p class="text-sm mt-1" style="color: var(--color-text-muted);">
          A <a href="https://3dwn.se" target="_blank" rel="noopener" style="color: var(--color-text-muted);" class="underline">Triple Down AB</a> project.
        </p>
      </div>
      <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a href={verifierUrl} class="hover:opacity-70">Verifier</a>
        <a href={verifierRepo} target="_blank" rel="noopener" class="hover:opacity-70">GitHub</a>
        <a href={`mailto:${contactEmail}`} class="hover:opacity-70">Contact</a>
      </nav>
    </div>
  </footer>
</Base>
