---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  CLOUD_URL as cloudUrl,
  VERIFIER_URL as verifierUrl,
  LABS_URL as labsUrl,
  VERIFIER_REPO as verifierRepo,
  NUGET_URL as nugetUrl,
  CONTACT_EMAIL as contactEmail,
  ACCESS_MAILTO as accessMailto,
} from '../consts';

const products = [
  {
    name: 'Tessio Cloud',
    tag: 'Hosted · live now',
    body: 'A hosted API and dashboard for age and identity checks on the EU Digital Identity Wallet. You get API keys, webhooks and usage analytics. You can start building today against the sandbox.',
    cta: { label: 'Request access', href: accessMailto },
    secondary: { label: 'Sign in', href: cloudUrl },
    highlight: true,
  },
  {
    name: 'Tessio.Verifier',
    tag: 'Open source · Apache-2.0',
    body: 'The ASP.NET Core verifier that Tessio Cloud runs on. It does OpenID4VP 1.0, SD-JWT VC and mdoc (mDL), and it passes the OpenID Foundation conformance suite for HAIP verifiers in both formats. Four run modes let you build before wallets ship. It is on NuGet for .NET 8 to 10, so you can run it yourself.',
    cta: { label: 'Get it on NuGet', href: nugetUrl },
    secondary: { label: 'View on GitHub', href: verifierRepo },
    highlight: false,
  },
];

const steps = [
  { n: '01', title: 'Call the API', body: 'POST a check to /v1/age-checks. You get back a hosted verification link. No SDK to install, no documents to handle.' },
  { n: '02', title: 'The user confirms', body: 'The person confirms one claim, like being over 18, from their EU Digital Identity Wallet. No ID scan, no selfie.' },
  { n: '03', title: 'You get a yes or no', body: 'A signed result lands on your webhook. You store the answer you need, and nothing else.' },
];

const timeline = [
  { date: 'Now', body: 'Tessio Cloud is live and Tessio.Verifier 0.4 is out. It passes the OpenID Foundation conformance suite for OpenID4VP 1.0 HAIP verifiers, in both SD-JWT VC and mdoc formats. You can build against the sandbox today.' },
  { date: 'Dec 2026', body: 'Member states have to make the EUDI Wallet available under Regulation (EU) 2024/1183. Real wallets, real credentials to verify.' },
  { date: 'Dec 2027', body: 'Acceptance becomes mandatory. Regulated relying parties need a verifier in production.' },
];

const faqs = [
  {
    q: 'What is Tessio Cloud?',
    a: 'A hosted API for age and identity checks on the EU Digital Identity Wallet. You send a check, the person proves a claim such as being over 18 from their wallet, and you get a signed yes or no back. You never handle documents, and we keep no personal data.',
  },
  {
    q: 'How does the age verification API work?',
    a: 'Your app calls the /v1/age-checks endpoint and gets a hosted verification link. The person confirms the claim from their EU Digital Identity Wallet, and the result comes back on your webhook. You can build against the sandbox today. Going live then needs two things beyond your integration: member states shipping the wallet, and us holding the relying party access certificate that wallets check before they release any data. We do not hold one yet, and no production wallet will accept a verifier without it.',
  },
  {
    q: 'Do you store personal data?',
    a: 'No. The result is an over-18 yes or no, not a date of birth or an ID document. There is no selfie and no ID scan, and we keep no personal data. You get the answer your compliance needs and nothing more.',
  },
  {
    q: 'Is it GDPR compliant?',
    a: 'We check one claim and store no personal data, which is the posture GDPR and the EU Digital Identity framework are built for. If you need the verifier inside your own boundary, you can self host it.',
  },
  {
    q: 'Is there an open source or self hosted option?',
    a: 'Yes. Tessio Cloud runs on Tessio.Verifier, our open source ASP.NET Core verifier for OpenID4VP, SD-JWT VC and mdoc. It is on NuGet under Apache-2.0, so you can build and run it on your own .NET stack.',
  },
  {
    q: 'Does Tessio pass the OpenID Foundation conformance tests?',
    a: 'Yes. Tessio.Verifier passes every applicable module of the OpenID Foundation conformance suite for OpenID4VP 1.0 verifiers under the High Assurance Interoperability Profile (HAIP), in both SD-JWT VC and mdoc formats. The suite plays the wallet and attacks the verifier: tampered credentials, replayed proofs, stale keys and broken session bindings all have to be rejected for the right reason. Passing it is our bar for a verifier release. We have not yet submitted for the official OpenID certification listing.',
  },
  {
    q: 'When must businesses accept the EU Digital Identity Wallet?',
    a: 'Member states have to make the wallet available by December 2026 under Regulation (EU) 2024/1183, and regulated relying parties have to accept it by December 2027.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'Tessio', url: 'https://tessio.eu' },
    {
      // Service, not Product: Google requires Product to carry offers, review or aggregateRating,
      // and we can honestly supply none of them. Tessio.Verifier and Tessio Labs below stay
      // SoftwareApplication with price 0, because those genuinely are free.
      '@type': 'Service',
      name: 'Tessio Cloud',
      url: cloudUrl,
      provider: { '@type': 'Organization', name: 'Tessio', url: 'https://tessio.eu' },
      serviceType: 'Age and identity verification API',
      areaServed: { '@type': 'Place', name: 'European Union' },
      description:
        'Hosted age and identity verification API for the EU Digital Identity Wallet. Over-18 checks that keep no personal data.',
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Tessio.Verifier',
      url: verifierUrl,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: '.NET 8 to 10',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      description:
        'Open-source, ASP.NET Core-native EUDI verifier for OpenID4VP, SD-JWT VC and mdoc. Passes the OpenID Foundation HAIP conformance suite in both formats. Apache-2.0, on NuGet.',
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Tessio Labs',
      url: labsUrl,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any (web)',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      description:
        'Free validators for EU digital identity and trust: SD-JWT VC credentials, with eIDAS signatures and mdoc to come.',
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
const labsTools = [
  {
    slug: 'sd-jwt',
    name: 'SD-JWT VC Validator',
    body: 'Decode a verifiable credential and check its disclosures bind to the signed digests.',
  },
  {
    slug: 'mdoc',
    name: 'mdoc / mDL Validator',
    body: 'Validate an ISO 18013-5 mobile document, its Mobile Security Object and its IACA chain.',
  },
  {
    slug: 'ades',
    name: 'eIDAS Signature Validator',
    body: 'Check a PAdES, CAdES or JAdES signature, its timestamp, and its EU trusted-list qualification.',
  },
  {
    slug: 'trusted-list',
    name: 'EU Trusted List Checker',
    body: 'See whether a certificate is a qualified CA on an EU trusted list, and which national list.',
  },
  {
    slug: 'lote',
    name: 'EUDI Trusted Entity Checker',
    body: 'See whether the EU wallet ecosystem trusts a certificate, as a PID, WRPAC or public EAA provider.',
  },
];

---

<Base>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} is:inline />

  <Header />

  <main class="flex-1">
    <!-- Hero -->
    <section class="max-w-6xl mx-auto px-6 pt-20 pb-16 md:pt-32 md:pb-24">
      <div class="max-w-3xl">
        <p class="text-sm font-medium uppercase tracking-widest mb-6" style="color: var(--color-accent);">
          Age verification · EU Digital Identity · .NET
        </p>
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight leading-[1.05] mb-6">
          Age and identity verification,<br />
          <span style="color: var(--color-text-muted);">on the EU Digital Identity Wallet.</span>
        </h1>
        <p class="text-lg md:text-xl leading-relaxed max-w-2xl mb-8" style="color: var(--color-text);">
          Tessio Cloud is a hosted verification API. You ask whether someone is over 18, they confirm it from their
          wallet, and you get back a signed yes or no.
          <span style="color: var(--color-text-muted);">No documents, no selfies, and no personal data kept.</span>
          It runs on our open source .NET verifier, which passes the OpenID Foundation HAIP conformance tests.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href={accessMailto}
            class="px-5 py-3 rounded-md font-medium transition-opacity hover:opacity-90"
            style="background-color: var(--color-accent); color: var(--color-accent-contrast);"
          >
            Request access →
          </a>
          <a
            href={nugetUrl}
            class="px-5 py-3 rounded-md font-medium border transition-colors"
            style="border-color: var(--color-border);"
          >
            Get the .NET verifier
          </a>
        </div>
        <p class="text-sm mt-6" style="color: var(--color-text-muted);">
          Live at <a href={cloudUrl} class="underline" style="color: var(--color-accent);">cloud.tessio.eu</a>.
          Built for iGaming, age-restricted retail, dating and adult platforms that have to meet UK OSA and EU DSA age rules.
        </p>
      </div>
    </section>

    <!-- Product preview -->
    <section class="max-w-6xl mx-auto px-6 pb-20 md:pb-28">
      <div class="rounded-xl border overflow-hidden shadow-2xl" style="border-color: var(--color-border);">
        <img
          src="/screenshots/checks-dark.jpg"
          width="1920"
          height="1200"
          alt="The Tessio Cloud dashboard: verification outcomes over the last 30 days and every age check with its status, result, method and reference."
          class="block w-full h-auto"
          loading="lazy"
          decoding="async"
        />
      </div>
      <p class="text-sm mt-4 text-center" style="color: var(--color-text-muted);">
        The Tessio Cloud dashboard: verification outcomes over time and every age check, with no personal data stored.
      </p>
    </section>

    <!-- Products -->
    <section class="max-w-6xl mx-auto px-6 pb-24" id="product">
      <h2 class="text-3xl font-bold tracking-tight mb-3">Two products, one core</h2>
      <p class="mb-12 text-lg max-w-2xl" style="color: var(--color-text-muted);">
        The hosted product for teams who want it run for them, and the open source verifier for teams who want to run it themselves.
      </p>
      <div class="grid gap-6 md:grid-cols-2">
        {
          products.map((p) => (
            <div
              class="rounded-xl border p-8 flex flex-col"
              style={`background-color: var(--color-bg-elevated); border-color: ${p.highlight ? 'var(--color-accent)' : 'var(--color-border)'};`}
            >
              <p class="text-xs font-medium uppercase tracking-widest mb-3" style="color: var(--color-accent);">
                {p.tag}
              </p>
              <h3 class="text-xl font-semibold tracking-tight mb-3">{p.name}</h3>
              <p class="text-sm leading-relaxed mb-6 flex-1" style="color: var(--color-text-muted);">
                {p.body}
              </p>
              <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
                <a
                  href={p.cta.href}
                  class="text-sm font-medium hover:opacity-70 transition-opacity"
                  style="color: var(--color-accent);"
                >
                  {p.cta.label} →
                </a>
                <a
                  href={p.secondary.href}
                  class="text-sm font-medium hover:opacity-70 transition-opacity"
                  style="color: var(--color-text-muted);"
                >
                  {p.secondary.label}
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Developer preview -->
    <section class="max-w-6xl mx-auto px-6 pb-20 md:pb-28">
      <div class="rounded-xl border overflow-hidden shadow-2xl" style="border-color: var(--color-border);">
        <img
          src="/screenshots/developer-dark.jpg"
          width="1920"
          height="1200"
          alt="The Tessio Cloud developer page: base URL, API-key authentication, and copy-paste request examples."
          class="block w-full h-auto"
          loading="lazy"
          decoding="async"
        />
      </div>
      <p class="text-sm mt-4 text-center" style="color: var(--color-text-muted);">
        A small REST API with keys, webhooks and copy-paste examples in your language.
      </p>
    </section>

    <!-- Tessio Labs -->
    <section class="max-w-6xl mx-auto px-6 pb-24" id="labs">
      <h2 class="text-3xl font-bold tracking-tight mb-3">Free tools in Tessio Labs</h2>
      <p class="mb-12 text-lg max-w-2xl" style="color: var(--color-text-muted);">
        Five free validators for EU digital identity and trust, on the same engine as Tessio Cloud.
        Nothing you paste is stored.
      </p>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          labsTools.map((tool) => (
            <a
              href={`${labsUrl}/${tool.slug}`}
              class="rounded-xl border p-6 block transition-colors hover:border-current"
              style="background-color: var(--color-bg-elevated); border-color: var(--color-border);"
            >
              <h3 class="text-base font-semibold tracking-tight mb-2">{tool.name}</h3>
              <p class="text-sm leading-relaxed mb-3" style="color: var(--color-text-muted);">{tool.body}</p>
              <span class="text-sm font-medium" style="color: var(--color-accent);">Open →</span>
            </a>
          ))
        }
      </div>
      <a
        href={labsUrl}
        class="inline-block mt-8 text-sm font-medium hover:opacity-70 transition-opacity"
        style="color: var(--color-accent);"
      >
        Open Tessio Labs →
      </a>
    </section>

    <!-- How it works -->
    <section class="max-w-6xl mx-auto px-6 pb-24" id="how">
      <h2 class="text-3xl font-bold tracking-tight mb-3">Age verification in three calls</h2>
      <p class="mb-12 text-lg max-w-2xl" style="color: var(--color-text-muted);">
        You get the claim you asked for, not the identity behind it.
      </p>
      <div class="grid gap-6 md:grid-cols-3">
        {
          steps.map((s) => (
            <div
              class="rounded-xl border p-6"
              style="background-color: var(--color-bg-elevated); border-color: var(--color-border);"
            >
              <p class="text-2xl font-mono font-bold mb-3" style="color: var(--color-accent);">{s.n}</p>
              <h3 class="text-base font-semibold tracking-tight mb-2">{s.title}</h3>
              <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">{s.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Why / Timeline -->
    <section class="max-w-6xl mx-auto px-6 pb-24" id="why">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="text-3xl font-bold tracking-tight mb-6">Why now</h2>
          <p class="text-base leading-relaxed mb-4" style="color: var(--color-text-muted);">
            Regulation <a href="https://eur-lex.europa.eu/eli/reg/2024/1183/oj" target="_blank" rel="noopener" style="color: var(--color-accent);" class="underline">(EU) 2024/1183</a>
            makes all 27 member states issue a Digital Identity Wallet, and makes relying parties in regulated sectors
            accept it by <strong style="color: var(--color-text);">December 2027</strong>. UK OSA and EU DSA age rules
            already apply today.
          </p>
          <p class="text-base leading-relaxed" style="color: var(--color-text-muted);">
            Most of the reference verifier work is in Kotlin and Rust, so .NET teams end up porting it. There are a lot
            of those teams in EU public sector and finance. Tessio gives them a verifier that fits, hosted or self-run.
          </p>
        </div>
        <div id="developers">
          <h3 class="text-sm font-medium uppercase tracking-widest mb-6" style="color: var(--color-text-muted);">
            Timeline
          </h3>
          <ol class="space-y-5">
            {
              timeline.map((t) => (
                <li class="border-l-2 pl-4" style="border-left-color: var(--color-accent);">
                  <p class="text-xs font-mono uppercase tracking-wider mb-1" style="color: var(--color-accent);">
                    {t.date}
                  </p>
                  <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">
                    {t.body}
                  </p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section class="max-w-6xl mx-auto px-6 pb-24" id="pricing">
      <h2 class="text-3xl font-bold tracking-tight mb-3">Pricing</h2>
      <p class="mb-8 text-lg max-w-2xl" style="color: var(--color-text-muted);">
        You pay for what you verify.
      </p>
      <div
        class="rounded-xl border p-8 max-w-3xl"
        style="background-color: var(--color-bg-elevated); border-color: var(--color-border);"
      >
        <p class="text-base leading-relaxed mb-4" style="color: var(--color-text-muted);">
          Tessio Cloud is usage-based. You pay a platform subscription for the dashboard, API keys and support, plus a
          per-check rate on top. The rate drops as your volume grows, and age checks are priced for high volume.
        </p>
        <p class="text-base leading-relaxed mb-6" style="color: var(--color-text-muted);">
          Early access is invite only, and design partners get preferential pricing while we build out. Tell us the
          volume you are planning and we will send a quote.
        </p>
        <a
          href={accessMailto}
          class="inline-block text-sm font-medium hover:opacity-70 transition-opacity"
          style="color: var(--color-accent);"
        >
          Request access and a quote →
        </a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="max-w-6xl mx-auto px-6 pb-24" id="faq">
      <h2 class="text-3xl font-bold tracking-tight mb-12">Frequently asked</h2>
      <div class="grid gap-x-12 gap-y-8 md:grid-cols-2">
        {
          faqs.map((f) => (
            <div>
              <h3 class="text-base font-semibold tracking-tight mb-2">{f.q}</h3>
              <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">{f.a}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Contact -->
    <section class="max-w-6xl mx-auto px-6 pb-24" id="contact">
      <div
        class="rounded-xl border-l-4 p-6 md:p-8"
        style="background-color: var(--color-bg-elevated); border-left-color: var(--color-accent); border-color: var(--color-border);"
      >
        <p class="text-xs font-medium uppercase tracking-widest mb-3" style="color: var(--color-accent);">
          Working on age or identity verification?
        </p>
        <h3 class="text-2xl font-bold tracking-tight mb-3">Let's talk.</h3>
        <p class="text-base leading-relaxed mb-6 max-w-2xl" style="color: var(--color-text-muted);">
          Tessio Cloud is invite only while we onboard design partners. We are talking to operators running
          age-assurance pilots, integrators planning their 2027 rollout, and member state teams looking for an
          EU-aligned reference stack. If that is you, get in touch.
        </p>
        <a
          href={accessMailto}
          class="inline-block px-5 py-3 rounded-md font-medium transition-opacity hover:opacity-90"
          style="background-color: var(--color-accent); color: var(--color-accent-contrast);"
        >
          {contactEmail}
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Base>
