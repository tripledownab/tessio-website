---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqList from '../components/FaqList.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Cta from '../components/Cta.astro';
import { breadcrumbLd, faqLd, definedTermLd, graph } from '../lib/seo';
import { ACCESS_MAILTO, LABS_URL } from '../consts';
import type { GlossaryTerm } from '../data/glossary';

interface RelatedLink {
  label: string;
  href: string;
  note?: string;
}
interface Props {
  term: GlossaryTerm;
  related: RelatedLink[];
}
const { term: t, related } = Astro.props;

const path = `/glossary/${t.slug}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Glossary', path: '/glossary' },
  { name: t.term, path },
];
const jsonLd = graph(
  breadcrumbLd(crumbs),
  definedTermLd({ name: t.term, alternateName: t.aka, description: t.short, slug: t.slug }),
  faqLd(t.faqs),
);
---

<Base title={t.title} description={t.description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} is:inline />

  <Header />

  <main class="flex-1">
    <!-- Hero: the term, then the one-sentence definition on its own, because that is the answer -->
    <section class="max-w-6xl mx-auto px-6 pt-16 pb-10 md:pt-24">
      <Breadcrumbs items={crumbs} />
      <p class="text-sm font-medium uppercase tracking-widest mb-4" style="color: var(--color-accent);">
        {t.category}
      </p>
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight leading-[1.1] mb-5">
        {t.term}
      </h1>
      <p class="text-lg md:text-xl leading-relaxed max-w-3xl" style="color: var(--color-text);">
        {t.short}
      </p>
      <p class="text-sm mt-5" style="color: var(--color-text-muted);">
        Also called: {t.aka.join(', ')}
      </p>
    </section>

    <!-- At a glance -->
    <section class="max-w-6xl mx-auto px-6 pb-14">
      <div
        class="rounded-xl border p-6 md:p-8"
        style="background-color: var(--color-bg-elevated); border-color: var(--color-border);"
      >
        <h2 class="text-sm font-medium uppercase tracking-widest mb-5" style="color: var(--color-text-muted);">
          At a glance
        </h2>
        <dl class="grid gap-x-8 gap-y-4 sm:grid-cols-2">
          {
            t.facts.map((f) => (
              <div class="border-l-2 pl-4" style="border-left-color: var(--color-accent);">
                <dt class="text-xs font-medium uppercase tracking-wider mb-1" style="color: var(--color-accent);">
                  {f.label}
                </dt>
                <dd class="text-sm leading-relaxed" style="color: var(--color-text);">
                  {f.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- The explanation -->
    <section class="max-w-6xl mx-auto px-6 pb-6">
      {
        t.sections.map((s) => (
          <div class="mb-12">
            <h2 class="text-2xl font-bold tracking-tight mb-4">{s.heading}</h2>
            {s.body.map((p) => (
              <p class="text-base leading-relaxed mb-4 max-w-3xl" style="color: var(--color-text-muted);">
                {p}
              </p>
            ))}
          </div>
        ))
      }
    </section>

    <!--
      Check one yourself. This block is the point of the whole glossary: a definition next to a free
      tool that inspects the thing being defined. Only rendered when we actually have a validator for
      the term, so it never degrades into a decorative "learn more" link.
    -->
    {
      t.tools.length > 0 && (
        <section class="max-w-6xl mx-auto px-6 pb-14">
          <div
            class="rounded-xl border-l-4 p-6 md:p-8"
            style="background-color: var(--color-bg-elevated); border-left-color: var(--color-accent); border-color: var(--color-border);"
          >
            <h2 class="text-2xl font-bold tracking-tight mb-3">Check one yourself</h2>
            <p class="text-base leading-relaxed mb-6 max-w-3xl" style="color: var(--color-text-muted);">
              Reading about it only gets you so far. These are free validators in Tessio.Labs, no signup, and
              nothing you paste is stored.
            </p>
            <div class="grid gap-4 sm:grid-cols-2">
              {t.tools.map((tool) => (
                <a
                  href={`${LABS_URL}${tool.href}`}
                  target="_blank"
                  rel="noopener"
                  class="block rounded-xl border p-5 transition-opacity hover:opacity-80"
                  style="background-color: var(--color-bg); border-color: var(--color-border);"
                >
                  <p class="font-medium tracking-tight mb-1">{tool.label}</p>
                  <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">
                    {tool.note}
                  </p>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Why it matters -->
    <section class="max-w-6xl mx-auto px-6 pb-14">
      <h2 class="text-2xl font-bold tracking-tight mb-4">Why it matters</h2>
      {
        t.whyItMatters.map((p) => (
          <p class="text-base leading-relaxed mb-4 max-w-3xl" style="color: var(--color-text-muted);">
            {p}
          </p>
        ))
      }
    </section>

    <FaqList faqs={t.faqs} />

    <!-- Primary sources -->
    <section class="max-w-6xl mx-auto px-6 pb-16">
      <h2 class="text-sm font-medium uppercase tracking-widest mb-4" style="color: var(--color-text-muted);">
        Primary sources
      </h2>
      <ul class="space-y-2 text-sm">
        {
          t.sources.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener" class="underline" style="color: var(--color-accent);">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="text-xs mt-4" style="color: var(--color-text-muted);">
        This is a plain language explanation, not legal advice. Specifications and dates in this area move, so
        check anything you are going to rely on against the primary sources.
      </p>
    </section>

    <RelatedLinks heading="Keep reading" links={related} />

    <Cta
      eyebrow="Age verification API"
      title="Or skip the theory and build against it"
      body="Tessio proves someone is over 18 from their EU Digital Identity Wallet and stores no personal data. Access is invite only while we onboard design partners. Tell us what you're building."
      buttonLabel="Request access"
      buttonHref={ACCESS_MAILTO}
      secondaryLabel="Read the docs"
      secondaryHref="/docs"
    />
  </main>

  <Footer />
</Base>
