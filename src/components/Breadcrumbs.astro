---
import type { Crumb } from '../lib/seo';
// Visible breadcrumb trail. The matching BreadcrumbList JSON-LD is emitted by the page layout.
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm mb-6" style="color: var(--color-text-muted);">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {
      items.map((c, i) => (
        <li class="flex items-center gap-x-2">
          {i < items.length - 1 ? (
            <a href={c.path} class="hover:opacity-70 transition-opacity">
              {c.name}
            </a>
          ) : (
            <span aria-current="page" style="color: var(--color-text);">
              {c.name}
            </span>
          )}
          {i < items.length - 1 && (
            <span aria-hidden="true" style="opacity: 0.5;">
              /
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
