---
import type { Faq } from '../lib/seo';
// Renders the visible FAQ. The FAQPage JSON-LD is emitted by the page layout from the same data.
interface Props {
  faqs: Faq[];
  heading?: string;
}
const { faqs, heading = 'Frequently asked' } = Astro.props;
---

<section class="max-w-6xl mx-auto px-6 pb-20">
  <h2 class="text-2xl font-bold tracking-tight mb-8">{heading}</h2>
  <div class="grid gap-x-12 gap-y-8 md:grid-cols-2">
    {
      faqs.map((f) => (
        <div>
          <h3 class="text-base font-semibold tracking-tight mb-2">{f.q}</h3>
          <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">
            {f.a}
          </p>
        </div>
      ))
    }
  </div>
</section>
