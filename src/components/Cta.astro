---
// The shared bottom-of-page call to action. Matches the accent panel on the homepage.
interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  buttonLabel: string;
  buttonHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const { eyebrow, title, body, buttonLabel, buttonHref, secondaryLabel, secondaryHref } = Astro.props;
---

<section class="max-w-6xl mx-auto px-6 pb-24">
  <div
    class="rounded-xl border-l-4 p-6 md:p-8"
    style="background-color: var(--color-bg-elevated); border-left-color: var(--color-accent); border-color: var(--color-border);"
  >
    {
      eyebrow && (
        <p class="text-xs font-medium uppercase tracking-widest mb-3" style="color: var(--color-accent);">
          {eyebrow}
        </p>
      )
    }
    <h2 class="text-2xl font-bold tracking-tight mb-3">{title}</h2>
    <p class="text-base leading-relaxed mb-6 max-w-2xl" style="color: var(--color-text-muted);">{body}</p>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
      <a
        href={buttonHref}
        class="inline-block px-5 py-3 rounded-md font-medium text-white transition-opacity hover:opacity-90"
        style="background-color: var(--color-accent);"
      >
        {buttonLabel} →
      </a>
      {
        secondaryLabel && secondaryHref && (
          <a
            href={secondaryHref}
            class="text-sm font-medium hover:opacity-70 transition-opacity"
            style="color: var(--color-text-muted);"
          >
            {secondaryLabel}
          </a>
        )
      }
    </div>
  </div>
</section>
